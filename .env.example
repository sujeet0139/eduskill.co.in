# Copy to .env and fill in real values. NEVER commit the real .env.
PORT=5000

# --- Managed MySQL (e.g. Aiven) ---
DB_HOST=187.127.162.29
DB_PORT=3306
DB_USER=eduskill
DB_PASSWORD=eduskill_secure_password
DB_NAME=eduskill
# Set to true for managed providers that require TLS (Aiven, etc.)
DB_SSL=false

# --- Auth ---
# Generate a strong random secret, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret

# --- Email (SMTP) ---
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=info@eduskill.co.in
SMTP_PASSWORD=change-me

# --- File uploads (object storage) ---
# Required in production (Vercel). Get from your Cloudinary dashboard.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- Optional: encryption key for sensitive fields (64-char hex) ---
ENCRYPTION_KEY=

# --- Admin seeding (used by `npm run seed:admin`) ---
ADMIN_EMAIL=admin@eduskill.co.in
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrator

# --- Payments (currently unused placeholders) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
